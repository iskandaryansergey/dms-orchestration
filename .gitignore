# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# Terraform
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
crash.log
*.tfplan
.terraform.tfstate.lock.info
override.tf
override.tf.json
