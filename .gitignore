# Local
.env
.env.*
*.pem
# The public Amazon RDS CA bundle of the Lambda SQL runtime, pinned by sha256 (make vendor-check).
!modules/dms-orchestration/src/lambdas/sql_jobs/rds-global-bundle.pem
.idea/
.vscode/

# Lock files belong to root configurations, not to the reusable module
modules/**/.terraform.lock.hcl
tfplan*

# Upstream aurora/dms modules: fetched by `sandbox.py fetch-upstream`, configured locally
examples/sandbox/upstream/
examples/sandbox/upstream.env

# Local fixes to third-party upstream modules stay local.
examples/sandbox/upstream-patches/*.patch
